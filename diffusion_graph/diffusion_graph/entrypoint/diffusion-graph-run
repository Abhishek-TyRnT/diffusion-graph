#!/usr/bin/python3
import argparse
import sys
import os
import torch
import uvicorn
import logging

# Setup logging
logger = logging.getLogger("diffusion-graph-run")

# Import the FastAPI app and logger
from diffusion_graph.entrypoint.api import app

def parse_args():
    
    parser = argparse.ArgumentParser(description="Diffusion Graph API Server")
    parser.add_argument("--model-path", type=str, required=True, help="Path to the diffusion model")
    parser.add_argument("--device", type=str, default="cuda" if torch.cuda.is_available() else "cpu", help="Device to run the model on")
    parser.add_argument("--tokenizer", type=str, required=True, help="Tokenizer name or path")
    parser.add_argument("--host", type=str, default="0.0.0.0", help="Host to bind the server to")
    parser.add_argument("--port", type=int, default=8000, help="Port to bind the server to")
    return parser.parse_args()

if __name__ == "__main__":
    
    args = parse_args()
    
    # Pass args directly via app.state.config so lifespan can read them without env vars.
    # We pass the app object (not the "module:app" string) to uvicorn so the same
    # process (and the same app object) is reused, preserving app.state.
    app.state.config = {
        "model_path": args.model_path,
        "device": args.device,
        "tokenizer": args.tokenizer,
    }
    
    logger.info(f"Starting server at http://{args.host}:{args.port}")
    try:
        # Run uvicorn server with the app object directly (not a string) so app.state is preserved.
        uvicorn.run(app, host=args.host, port=args.port, log_level="info")
    except KeyboardInterrupt:
        logger.info("KeyboardInterrupt caught in entrypoint wrapper. Shutting down gracefully...")
        sys.exit(0)

